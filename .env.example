# Shared secret required to create/edit/delete goals and add/remove contributions
# via the API. Reads are open (it's your own tracker on a private Tailscale
# network). Generate one with:  openssl rand -hex 24
JARVIS_TOKEN=change-me-to-a-long-random-string

# Where the SQLite file lives (optional; defaults to ./data/savings.db).
# Each environment gets its own DB, so dev + prod never share data.
# SAVINGS_DB_PATH=/opt/savings-tracker/data/savings.db

# Set to "dev" on the DEV deployment to show the amber non-prod banner.
# Leave UNSET on prod. (Prod is also hard-guarded by its :4740 port.)
# JARVIS_ENV=dev
