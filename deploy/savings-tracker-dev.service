[Unit]
Description=Savings Goals (Next.js) — DEV
After=network.target

[Service]
Type=simple
User=dan
WorkingDirectory=/opt/savings-tracker-dev
Environment=NODE_ENV=production
# Dev has its own .env (separate JARVIS_TOKEN, JARVIS_ENV=dev, and an isolated
# SQLite DB under /opt/savings-tracker-dev/data/).
EnvironmentFile=/opt/savings-tracker-dev/.env
# next directly so we override the start script's hardcoded :4740; dev = :4750.
ExecStart=/opt/savings-tracker-dev/node_modules/.bin/next start -p 4750
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
